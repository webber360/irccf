# Security headers for every response.
# CSP: scripts only from this site, two inline scripts by hash, Google Tag Manager and
# Cloudflare Web Analytics (both load only after cookie consent, via @webber360/consent).
#  - 1st hash: the inline theme script. If you edit it in any page, recompute its sha256 and
#    replace it below, or the theme will stop applying on load.
#  - 2nd hash: the @webber360/consent head script. Never edit it by hand:
#    python3 scripts/consent-sync.py writes it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-cWxySqodxdi5xm0SGNf+gERfvIw0f7JwNaoVfD9akTg=' 'sha256-iLAAZkq0mCLyi9UDFrQngF3YpKpl/WFmshue9cKMkQo=' https://*.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  X-Permitted-Cross-Domain-Policies: none

# Keep the workers.dev copy of the site (and its preview URLs) out of search indexes.
# These rules match only *.workers.dev hosts, so irccf.org stays indexable.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

https://:version.:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/site.webmanifest
  Content-Type: application/manifest+json
